{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dilla-bobby-wedding",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dilla-bobby-wedding",
      "database_id": "20f5dd5b-7089-412b-9a82-6b18b40a6dd2",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://dilla-bobby-wedding.YOUR-SUBDOMAIN.workers.dev"
  }
}
